# Voicebot Latest - Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================

# Deepgram API Key for Speech-to-Text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS Credentials for Polly (Text-to-Speech)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application Environment
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_FORMAT=linear16

# LLM Configuration
LLM_MODEL=nova-3
LANGUAGE=en-US
MAX_TOKENS=500
TEMPERATURE=0.7

# Voice Settings
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# =============================================================================
# DATA PERSISTENCE
# =============================================================================

# Conversation Storage
CONVERSATIONS_FILE=conversations.json
MAX_CONVERSATION_HISTORY=10

# Database Configuration (for future use)
POSTGRES_DB=voicebot
POSTGRES_USER=voicebot_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_DB=0

# =============================================================================
# MONITORING & METRICS
# =============================================================================

# Health Check Settings
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# Performance Monitoring
ENABLE_PERFORMANCE_LOGGING=true
CACHE_TTL_MINUTES=30
MAX_CACHE_SIZE=500

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# CORS Configuration
CORS_ORIGINS=["*"]  # Restrict in production
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_ENABLED=true

# JWT Configuration (for authentication)
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# DOCKER & DEPLOYMENT
# =============================================================================

# Container Settings
CONTAINER_PORT=8000
WORKERS=1

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development Tools
ENABLE_DOCS=true
ENABLE_DEBUG_ENDPOINTS=false
AUTO_RELOAD=false

# Testing
TEST_MODE=false
MOCK_EXTERNAL_APIs=false

# Logging Configuration
LOG_FILE_PATH=./logs/voicebot.log
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=30

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_CONNECTION_TIMEOUT=300

# Audio Processing
AUDIO_CHUNK_SIZE=1024
AUDIO_BUFFER_SIZE=8192
ENABLE_NOISE_REDUCTION=true

# LLM Optimization
ENABLE_RESPONSE_CACHING=true
ENABLE_STREAMING_OPTIMIZATION=true
MAX_CONCURRENT_REQUESTS=10

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=./backups

# =============================================================================
# EXAMPLE VALUES (DO NOT USE IN PRODUCTION)
# =============================================================================

# These are example values for development/testing
# DEEPGRAM_API_KEY=example_deepgram_key_12345
# AZURE_OPENAI_API_KEY=example_azure_key_67890
# AWS_ACCESS_KEY_ID=AKIA_EXAMPLE_KEY
# AWS_SECRET_ACCESS_KEY=example_secret_key_abcdef

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit your actual .env file to version control
# 2. Use strong passwords and rotate keys regularly
# 3. Restrict CORS origins in production environments
# 4. Enable SSL/TLS for production deployments
# 5. Monitor API usage and costs regularly
# 6. Set up proper backup strategies for conversation data
# 7. Configure logging and monitoring for production use